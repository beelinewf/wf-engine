# BeelineWF environment variables. These mirror config.yaml keys; the app
# consults them only when no config file is present. Copy to .env when
# running via docker-compose (compose loads it automatically).

# HTTP listen address for the API and dispatcher.
BEELINEWF_INFRA_HTTP_HOST=localhost:9999
# Expose Swagger UI at /swagger/index.html.
BEELINEWF_INFRA_HTTP_SWAGGER_ENABLED=true
# Expose Prometheus exposition at GET /metrics on the same port.
# false leaves no route (404).
BEELINEWF_INFRA_HTTP_METRICS_ENABLED=true
# CORS for browser frontends on another origin. "*" allows any origin (the
# development default); list explicit origins to restrict, or an empty list
# in the config file to disable CORS. List values are comma-separated.
BEELINEWF_INFRA_HTTP_CORS_ALLOWED_ORIGINS=*
BEELINEWF_INFRA_HTTP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
BEELINEWF_INFRA_HTTP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Api-Token
BEELINEWF_INFRA_HTTP_CORS_EXPOSED_HEADERS=
BEELINEWF_INFRA_HTTP_CORS_ALLOW_CREDENTIALS=false
BEELINEWF_INFRA_HTTP_CORS_MAX_AGE=12h

# PostgreSQL DSN (pgx/postgres wire format).
BEELINEWF_INFRA_POSTGRESQL_DSN=host=localhost user=gorm password=gorm dbname=gorm port=9921 sslmode=disable
# PostgreSQL pool ceiling (per replica). Exhaustion degrades to latency, not
# errors; size max_open_conns ≈ (engine workers × peak queries per
# transition) + headroom, divided across expected replicas.
BEELINEWF_INFRA_POSTGRESQL_MAX_OPEN_CONNS=25
BEELINEWF_INFRA_POSTGRESQL_MAX_IDLE_CONNS=25
BEELINEWF_INFRA_POSTGRESQL_CONN_MAX_LIFETIME=5m
BEELINEWF_INFRA_POSTGRESQL_CONN_MAX_IDLE_TIME=5m

# Optional brokers. Empty DSN disables the transport; a configured but
# unreachable broker fails startup.
BEELINEWF_INFRA_REDIS_DSN=
BEELINEWF_INFRA_RABBITMQ_DSN=
# RabbitMQ durable queue names (defaults when unset).
BEELINEWF_INFRA_RABBITMQ_INPUT_QUEUE=beelinewf.input
BEELINEWF_INFRA_RABBITMQ_OUTPUT_QUEUE=beelinewf.output
BEELINEWF_INFRA_RABBITMQ_STATUS_QUEUE=beelinewf.status

# ants worker pool.
BEELINEWF_WORKER_POOL_SIZE=100
BEELINEWF_WORKER_EXPIRY_DURATION=5m
BEELINEWF_WORKER_MAX_BLOCKING_TASKS=16
BEELINEWF_WORKER_PRE_ALLOC=false
BEELINEWF_WORKER_NON_BLOCKING=false
BEELINEWF_WORKER_DISABLE_PURGE=false

# Engine limits (Go duration strings).
BEELINEWF_ENGINE_DEFAULT_NODE_TIMEOUT=30s
BEELINEWF_ENGINE_MAX_NODE_TIMEOUT=5m
BEELINEWF_ENGINE_CONDITION_TIMEOUT=5s
BEELINEWF_ENGINE_MAX_PER_NODE_EXECUTIONS=100
BEELINEWF_ENGINE_MAX_TOTAL_EXECUTIONS=1000
BEELINEWF_ENGINE_LEASE_DURATION=30s
BEELINEWF_ENGINE_CLAIM_BATCH_SIZE=10
BEELINEWF_ENGINE_MAX_OUTPUT_BYTES=1048576
BEELINEWF_ENGINE_MAX_REDIRECTS=5
# Comma-separated allowlist of http(s) targets for external HTTP nodes.
# openrouter.ai is required by the openrouter and jev custom nodes.
BEELINEWF_ENGINE_HTTP_ALLOWLIST=http://127.0.0.1:8080,openrouter.ai
# Comma-separated allowlist of executables for command nodes. Entries must be
# absolute paths; bare names fail startup.
BEELINEWF_ENGINE_EXEC_ALLOWLIST=/bin/echo,/bin/ls
# Broker input consumer supervision (see config.yaml engine.consumer_retry).
BEELINEWF_ENGINE_CONSUMER_RETRY_MAX_ATTEMPTS=3
BEELINEWF_ENGINE_CONSUMER_RETRY_INITIAL_BACKOFF=1s
BEELINEWF_ENGINE_CONSUMER_RETRY_MAX_BACKOFF=30s
BEELINEWF_ENGINE_CONSUMER_RETRY_MIN_HEALTHY_RUN=30s

# API token authentication. When enabled, every /v1 endpoint requires the
# X-Api-Token header. A valid token authenticates the service principal,
# which bypasses every authorization gate; treat it as a machine credential.
# /health/* and GET /v1/auth/config stay public.
BEELINEWF_AUTH_ENABLED=false
BEELINEWF_API_TOKEN=

# OIDC resource server. The engine keeps no sessions and no callback: the
# frontend runs code+PKCE against the provider and calls the API with
# Authorization: Bearer <JWT>. The frontend reads issuer, client_id, the
# endpoints, and the roles claim from GET /v1/auth/config.
BEELINEWF_AUTH_OIDC_ENABLED=false
BEELINEWF_AUTH_OIDC_ISSUER=
BEELINEWF_AUTH_OIDC_CLIENT_ID=
# Expected aud claim; empty falls back to the client id.
BEELINEWF_AUTH_OIDC_AUDIENCE=
# Claim carrying the caller's roles.
BEELINEWF_AUTH_OIDC_ROLES_CLAIM=roles
# Claim used as the display name; falls back to preferred_username then email.
BEELINEWF_AUTH_OIDC_USERNAME_CLAIM=name
# Tolerance for clock drift on exp only; nbf still rejects a token issued
# ahead of this clock.
BEELINEWF_AUTH_OIDC_CLOCK_SKEW=1m
# How long a fetched JWKS stays fresh. This also bounds how often the
# provider is contacted: a rejected token never forces its own fetch.
# Values below 1m are clamped to 1m.
BEELINEWF_AUTH_OIDC_CACHE_TTL=5m

# Role catalog as JSON object of role name to action list. Empty keeps the
# file/default catalog; a set value overrides the config file. Must stay
# valid JSON or the app fails startup with
# `configuration: BEELINEWF_AUTH_ROLE_PERMISSIONS: invalid JSON`.
# Example:
#BEELINEWF_AUTH_ROLE_PERMISSIONS={"admin":["definitions:read","roles:read"],"finance":["instances:read"]}
BEELINEWF_AUTH_ROLE_PERMISSIONS=

# OpenRouter API key for the openrouter and jev custom nodes. It is
# snapshotted into each instance context at creation and referenced as
# {{ env.BEELINEWF_OPENROUTER_KEY }}. Keep this value out of committed files.
#BEELINEWF_OPENROUTER_KEY=

# System audit actor.
BEELINEWF_SYSTEM_USER_ID=00000000-0000-7000-8000-000000000001
BEELINEWF_SYSTEM_NAME=system
BEELINEWF_SYSTEM_EMAIL=system@localhost

# S3-compatible storage for the s3fetch example custom node. Only BEELINEWF_*
# vars are visible to workflows, snapshotted at instance creation under the
# reserved env root (address as {{ env.BEELINEWF_S3_ENDPOINT }} etc.).
# Local compose runs RustFS (rustfs/rustfs) with these dev credentials and
# plain HTTP; match with "use_ssl": false in the s3fetch config.
#BEELINEWF_S3_ENDPOINT=localhost:9000
#BEELINEWF_S3_ACCESS_KEY=rustfsadmin
#BEELINEWF_S3_SECRET_KEY=rustfsadmin
